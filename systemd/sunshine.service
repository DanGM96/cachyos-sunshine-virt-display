# CachyOS's sunshine pacman package ships no systemd unit. This one runs
# Sunshine as a user service and wires the stop script into ExecStopPost so
# physical monitors get restored even if Sunshine crashes mid-session.
#
# Paths use the %h specifier (invoking user's home dir, resolved by systemd
# at runtime) so this works regardless of which user installs it or where
# this repo was cloned from — no hardcoded username/path needed.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/sunshine.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sunshine
#
# Verify the binary path below matches your install: `which sunshine`.

[Unit]
Description=Sunshine self-hosted game stream host for Moonlight
After=graphical-session.target

[Service]
ExecStart=/usr/bin/sunshine
ExecStopPost=%h/.local/bin/sunshine-stop-vmon.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
